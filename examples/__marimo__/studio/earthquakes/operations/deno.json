{
  "lock": {
    "path": "deno.lock",
    "frozen": true
  },
  "nodeModulesDir": "none",
  "minimumDependencyAge": "P7D",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "npm:@types/react@19.2.10",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "strict": true,
    "types": [
      "./src/marimo-studio.d.ts",
      "npm:@types/react@19.2.10",
      "npm:@types/react-dom@19.2.3"
    ]
  },
  "imports": {
    "maplibre-gl": "npm:maplibre-gl@6.5.0",
    "react": "npm:react@19.2.4",
    "react-map-gl": "npm:react-map-gl@8.1.2",
    "react/jsx-runtime": "npm:react@19.2.4/jsx-runtime",
    "react-dom/client": "npm:react-dom@19.2.4/client",
    "typescript": "npm:typescript@6.0.3"
  },
  "fmt": {
    "include": ["deno.json", "src/"]
  },
  "lint": {
    "include": ["src/"]
  }
}
