{
  "lock": {
    "path": "deno.lock",
    "frozen": true
  },
  "nodeModulesDir": "none",
  "minimumDependencyAge": "P7D",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "strict": true,
    "types": ["npm:@types/react@19.2.10", "npm:@types/react-dom@19.2.3"]
  },
  "imports": {
    "@fontsource/hanken-grotesk": "npm:@fontsource/hanken-grotesk@5.3.0",
    "@fontsource/newsreader": "npm:@fontsource/newsreader@5.3.0",
    "@react-pdf/renderer": "npm:@react-pdf/renderer@4.8.1",
    "events": "npm:events@3.3.0",
    "pdfjs-dist": "npm:pdfjs-dist@5.4.149",
    "react": "npm:react@19.2.4",
    "react/jsx-runtime": "npm:react@19.2.4/jsx-runtime",
    "react-dom/client": "npm:react-dom@19.2.4/client",
    "typescript": "npm:typescript@6.0.3"
  },
  "tasks": {
    "sync:fonts": "deno run --unstable-raw-imports --allow-write=public/fonts scripts/sync-fonts.ts"
  },
  "fmt": {
    "include": ["deno.json", "scripts/", "src/"]
  },
  "lint": {
    "include": ["scripts/", "src/"]
  }
}
