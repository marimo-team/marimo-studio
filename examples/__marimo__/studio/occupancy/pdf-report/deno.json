{
  "lock": {
    "path": "deno.lock",
    "frozen": true
  },
  "nodeModulesDir": "none",
  "minimumDependencyAge": "P7D",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2023"
    ],
    "strict": true,
    "types": [
      "npm:@types/react@19.2.10",
      "npm:@types/react-dom@19.2.3"
    ]
  },
  "imports": {
    "@takumi-rs/helpers": "npm:@takumi-rs/helpers@2.10.0",
    "pdfjs-dist": "npm:pdfjs-dist@5.4.149",
    "react": "npm:react@19.2.4",
    "react-dom/client": "npm:react-dom@19.2.4/client",
    "react/jsx-runtime": "npm:react@19.2.4/jsx-runtime",
    "takumi-pdf": "npm:takumi-pdf@0.11.0",
    "takumi-pdf/no-init": "npm:takumi-pdf@0.11.0/no-init",
    "takumi-pdf/primitives": "npm:takumi-pdf@0.11.0/primitives",
    "typescript": "npm:typescript@6.0.3"
  },
  "fmt": {
    "include": [
      "deno.json",
      "src/"
    ]
  },
  "lint": {
    "include": [
      "src/"
    ]
  }
}
