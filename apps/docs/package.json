{
  "name": "@marimo-studio/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm test && pnpm examples:build && vitepress build && pnpm verify",
    "dev": "portless",
    "dev:server": "pnpm examples:build && node scripts/serve-docs.ts dev",
    "install-browser": "playwright install --with-deps chromium",
    "examples:build": "node scripts/build-examples.ts",
    "preview": "portless run --name preview.docs.marimo-studio pnpm run preview:server",
    "preview:server": "node scripts/serve-docs.ts preview",
    "test": "vp test scripts/source-integrity.test.ts scripts/example-publication.test.ts scripts/example-selection.test.ts scripts/server-arguments.test.ts",
    "thumbnails": "node scripts/capture-thumbnails.ts",
    "verify": "node scripts/verify-build.ts"
  },
  "devDependencies": {
    "@iconify/vue": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "portless": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitepress": "catalog:",
    "vitepress-plugin-llms": "1.13.2",
    "vue": "catalog:"
  },
  "portless": {
    "name": "docs.marimo-studio",
    "script": "dev:server"
  }
}
