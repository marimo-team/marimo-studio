{
  "schema": 1,
  "shared_cli_options": ["--format", "--diagnostics"],
  "code_mode_utilities": [
    {
      "call": "agent_plugin",
      "summary": "Return the installed portable Agent Plugin resources."
    },
    {
      "call": "agent_skill",
      "summary": "Return the packaged Marimo Studio skill resources."
    },
    {
      "call": "notebook_path",
      "summary": "Resolve the saved notebook from a code-mode context."
    }
  ],
  "capabilities": [
    {
      "id": "studio.overview",
      "summary": "Describe notebook configuration and authored views.",
      "mutation": "none",
      "executes_notebook": false,
      "prerequisites": ["saved-notebook"],
      "request": null,
      "result": {
        "type": "marimo_studio.overview.StudioOverview",
        "record": "StudioOverview",
        "schema": 1
      },
      "interfaces": {
        "code_mode": {
          "module": "marimo_studio.agent",
          "call": "overview",
          "async": false
        },
        "cli": {
          "command": ["overview"],
          "machine_output": ["--format", "json"]
        }
      },
      "parameters": [],
      "guide": "SKILL.md"
    },
    {
      "id": "studio.inspect",
      "summary": "Inspect selected cells in the saved notebook graph.",
      "mutation": "none",
      "executes_notebook": false,
      "prerequisites": ["saved-notebook"],
      "request": null,
      "result": {
        "type": "marimo_studio.inspect.InspectionResult",
        "record": "InspectionResult",
        "schema": 1
      },
      "interfaces": {
        "code_mode": {
          "module": "marimo_studio.agent",
          "call": "inspect",
          "async": false
        },
        "cli": {
          "command": ["inspect"],
          "machine_output": ["--format", "json"],
          "extensions": [
            {
              "options": ["--runtime", "--runtime-timeout"],
              "executes_notebook": true
            }
          ]
        }
      },
      "parameters": [
        {
          "name": "include_code",
          "default": false,
          "code_mode": "include_code",
          "cli": "--include-code"
        },
        {
          "name": "display",
          "default": false,
          "code_mode": "display",
          "cli": "--display"
        },
        {
          "name": "limit",
          "default": null,
          "minimum": 1,
          "code_mode": "limit",
          "cli": "--limit"
        }
      ],
      "guide": "references/view-authoring.md"
    },
    {
      "id": "studio.view.ensure",
      "summary": "Create a named view or return its current files.",
      "mutation": "files",
      "executes_notebook": false,
      "prerequisites": ["saved-notebook"],
      "request": null,
      "result": {
        "type": "marimo_studio.workspace.ViewSetupResult",
        "record": "ViewSetupResult",
        "schema": 1
      },
      "interfaces": {
        "code_mode": {
          "module": "marimo_studio.agent",
          "call": "ensure_view",
          "async": false
        },
        "cli": {
          "command": ["view", "add"],
          "machine_output": ["--format", "json"]
        }
      },
      "parameters": [
        {
          "name": "name",
          "default": null,
          "code_mode": "name",
          "cli": "--name"
        },
        {
          "name": "dry_run",
          "default": false,
          "code_mode": "dry_run",
          "cli": "--dry-run"
        }
      ],
      "guide": "SKILL.md"
    },
    {
      "id": "studio.bind",
      "summary": "Bind a stable alias to a notebook cell.",
      "mutation": "configuration",
      "executes_notebook": false,
      "prerequisites": ["configured-workspace"],
      "request": null,
      "result": {
        "type": "marimo_studio.workspace.BindingResult",
        "record": "BindingResult",
        "schema": 1
      },
      "interfaces": {
        "code_mode": {
          "module": "marimo_studio.agent",
          "call": "bind",
          "async": false
        },
        "cli": {
          "command": ["bind"],
          "machine_output": ["--format", "json"]
        }
      },
      "parameters": [
        {
          "name": "alias",
          "required": true,
          "code_mode": "alias",
          "cli": "--as"
        },
        {
          "name": "cell_index",
          "required": true,
          "minimum": 0,
          "code_mode": "cell_index",
          "cli": "--cell"
        },
        {
          "name": "dry_run",
          "default": false,
          "code_mode": "dry_run",
          "cli": "--dry-run"
        },
        {
          "name": "overwrite",
          "default": false,
          "code_mode": "overwrite",
          "cli": "--overwrite"
        }
      ],
      "guide": "references/view-authoring.md"
    },
    {
      "id": "studio.view.activate",
      "summary": "Activate a configured view in Build and refresh its preview when already active.",
      "mutation": "browser",
      "executes_notebook": false,
      "prerequisites": ["configured-view", "live-studio-server", "connected-browser"],
      "request": {
        "type": "marimo_studio.activation.ViewActivationRequest",
        "schema": 1
      },
      "result": {
        "type": "marimo_studio.activation.ViewActivationResult",
        "record": "ViewActivationResult",
        "schema": 1
      },
      "interfaces": {
        "code_mode": {
          "module": "marimo_studio.agent",
          "call": "activate_view",
          "async": true
        },
        "cli": {
          "command": ["view", "activate"],
          "machine_output": ["--format", "json"],
          "connection_options": ["--server", "--browser-client"],
          "environment": {
            "MARIMO_STUDIO_SERVER_URL": "--server",
            "MARIMO_STUDIO_BROWSER_CLIENT": "--browser-client"
          },
          "credentials": ["MARIMO_STUDIO_ACCESS_TOKEN"]
        }
      },
      "parameters": [
        {
          "name": "name",
          "required": true,
          "code_mode": "name",
          "cli": "--name"
        }
      ],
      "errors": [
        "invalid-activation-request",
        "view-not-found",
        "unknown-session",
        "browser-client-ambiguous",
        "browser-client-unavailable",
        "browser-session-unavailable",
        "browser-operation-in-progress",
        "browser-session-changed",
        "browser-view-changed",
        "activation-timeout",
        "notebook-mismatch",
        "protocol-error"
      ],
      "guide": "references/analysis-and-handoff.md"
    },
    {
      "id": "studio.check",
      "summary": "Validate saved notebook and view references.",
      "mutation": "none",
      "executes_notebook": false,
      "prerequisites": ["configured-workspace"],
      "request": null,
      "result": {
        "type": "marimo_studio.checks.CheckReport",
        "record": "CheckReport",
        "schema": 1
      },
      "interfaces": {
        "code_mode": {
          "module": "marimo_studio.agent",
          "call": "check",
          "async": false
        },
        "cli": {
          "command": ["check"],
          "machine_output": ["--format", "json"],
          "extensions": [
            {
              "options": ["--runtime", "--runtime-timeout"],
              "executes_notebook": true
            }
          ]
        }
      },
      "parameters": [
        {
          "name": "view",
          "default": null,
          "code_mode": "view_name",
          "cli": "--view"
        }
      ],
      "guide": "references/analysis-and-handoff.md"
    },
    {
      "id": "studio.analyze",
      "summary": "Collect source, runtime, and browser evidence for handoff.",
      "mutation": "execution",
      "executes_notebook": true,
      "prerequisites": ["configured-workspace"],
      "request": {
        "type": "marimo_studio.analysis.AnalysisRequest",
        "schema": 1
      },
      "result": {
        "type": "marimo_studio.analysis.AnalysisReport",
        "record": "AnalysisReport",
        "schema": 1
      },
      "interfaces": {
        "code_mode": {
          "module": "marimo_studio.agent",
          "call": "analyze",
          "async": true
        },
        "cli": {
          "command": ["analyze"],
          "machine_output": ["--format", "json"],
          "connection_options": ["--server", "--browser-client"],
          "environment": {
            "MARIMO_STUDIO_SERVER_URL": "--server",
            "MARIMO_STUDIO_BROWSER_CLIENT": "--browser-client"
          },
          "credentials": ["MARIMO_STUDIO_ACCESS_TOKEN"]
        }
      },
      "parameters": [
        {
          "name": "view",
          "default": null,
          "code_mode": "view",
          "cli": "--view"
        },
        {
          "name": "browser_timeout",
          "default": 10.0,
          "minimum": 0.0,
          "maximum": 300.0,
          "code_mode": "browser_timeout",
          "cli": "--browser-timeout"
        },
        {
          "name": "runtime_timeout",
          "default": 60.0,
          "minimum": 0.0,
          "maximum": 300.0,
          "code_mode": "runtime_timeout",
          "cli": "--runtime-timeout"
        },
        {
          "name": "require_browser",
          "default": true,
          "code_mode": "require_browser",
          "cli": "--browser/--no-browser"
        }
      ],
      "guide": "references/analysis-and-handoff.md"
    },
    {
      "id": "studio.view.remove",
      "summary": "Remove a named view and its source files.",
      "mutation": "files",
      "executes_notebook": false,
      "prerequisites": ["configured-workspace", "two-or-more-views"],
      "request": null,
      "result": {
        "type": "marimo_studio.workspace.ViewRemovalResult",
        "record": "ViewRemovalResult",
        "schema": 1
      },
      "interfaces": {
        "code_mode": null,
        "cli": {
          "command": ["view", "remove"],
          "machine_output": ["--format", "json"],
          "extensions": [{ "options": ["--yes"], "executes_notebook": false }],
          "reason": "The CLI owns confirmation and non-interactive safety."
        }
      },
      "parameters": [
        {
          "name": "name",
          "required": true,
          "cli": "--name"
        }
      ],
      "guide": "references/analysis-and-handoff.md"
    },
    {
      "id": "studio.export",
      "summary": "Export one view as a static WebAssembly site.",
      "mutation": "output",
      "executes_notebook": false,
      "prerequisites": ["configured-workspace", "wasm-compatible-notebook"],
      "request": null,
      "result": {
        "type": "marimo_studio.export.StaticExportResult",
        "record": "StaticExportResult",
        "schema": 1
      },
      "interfaces": {
        "code_mode": null,
        "cli": {
          "command": ["export"],
          "machine_output": ["--format", "json"],
          "extensions": [{ "options": ["--force"], "executes_notebook": false }],
          "reason": "The CLI owns destination paths and overwrite safety."
        }
      },
      "parameters": [
        {
          "name": "view",
          "default": null,
          "cli": "--view"
        },
        {
          "name": "output",
          "required": true,
          "cli": "-o/--output"
        }
      ],
      "guide": "references/analysis-and-handoff.md"
    }
  ]
}
